# Copiá este archivo como ".env" y completá tus datos

# Puerto donde corre la API
PORT=3000

# Datos de tu MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=limpieza

# Proyecto de Firebase (para verificar el login de los usuarios)
FIREBASE_PROJECT_ID=primera-app-9b798

# Dirección del frontend Angular (para permitir los pedidos)
CORS_ORIGIN=http://localhost:4200
